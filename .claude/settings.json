{
  "permissions": {
    "allow": [
      "Bash(git status*)",
      "Bash(git branch*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git fetch*)",
      "Bash(git rev-parse*)",
      "Bash(git rev-list*)",
      "Bash(git add -- *)",
      "Bash(git commit --only *)",
      "Bash(git commit -m *)",
      "Bash(git push origin master)",
      "Bash(.venv/Scripts/python.exe -m pytest*)",
      "Bash(.venv/Scripts/python.exe -m py_compile*)",
      "Bash(.venv/Scripts/python.exe scripts/autopilot*)",
      "Bash(.venv\\Scripts\\python.exe -m pytest*)",
      "Bash(.venv\\Scripts\\python.exe scripts\\autopilot*)",
      "Bash(python -m scripts.autopilot.cli*)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push --force-with-lease*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(git clean -x*)",
      "Bash(git add -A*)",
      "Bash(git add .)",
      "Bash(git add --all*)",
      "Bash(git branch -D*)",
      "Bash(git push*--delete*)",
      "Bash(*--no-verify*)",
      "Write(app_corrupted_backup.py)",
      "Edit(app_corrupted_backup.py)",
      "Write(nasdaq_3m.csv)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": ".venv\\Scripts\\python.exe scripts\\autopilot\\hooks\\pre_bash_safety_check.py"
          }
        ]
      }
    ]
  }
}
